# Database (SQLite - archivo local)
DATABASE_URL=dev.db

# Server
PORT=3000
NODE_ENV=development

# Session Secret (genera uno aleatorio para producción)
SESSION_SECRET=dev-secret-change-in-production

# Replit Auth (obtén estos valores de tu Repl)
REPLIT_CLIENT_ID=your-client-id
REPLIT_CLIENT_SECRET=your-client-secret
REPLIT_REDIRECT_URI=http://localhost:3000/api/auth/callback
